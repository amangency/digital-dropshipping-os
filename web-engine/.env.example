# ==============================================================================
# DIGITAL PRODUCT FUNNEL ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY: RAZORPAY
# Obtain from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Razorpay Webhook Secret (from Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 3. META / FACEBOOK PIXEL & CONVERSIONS API (CAPI)
# Obtain from: https://business.facebook.com/events_manager2
# ------------------------------------------------------------------------------
# Client-side Pixel ID (Injected at build/runtime)
VITE_FB_PIXEL_ID=YOUR_META_PIXEL_ID

# Server-side Conversions API (CAPI)
FB_PIXEL_ID=YOUR_META_PIXEL_ID
# System User Access Token (Events Manager -> Settings -> Generate Access Token)
FB_ACCESS_TOKEN=YOUR_META_SYSTEM_USER_ACCESS_TOKEN

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL: RESEND
# Obtain from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
FROM_EMAIL="Your Brand <orders@yourdomain.com>"
REPLY_TO="support@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. DIGITAL ASSET DELIVERY LINKS (GOOGLE DRIVE / S3 / CDN)
# ------------------------------------------------------------------------------
LINK_BASE_BUNDLE="https://drive.google.com/drive/folders/YOUR_BASE_BUNDLE_LINK"
LINK_CORE_BUMP1="https://drive.google.com/drive/folders/YOUR_CORE_BUMP1_LINK"
LINK_CORE_BUMP2="https://drive.google.com/drive/folders/YOUR_CORE_BUMP2_LINK"
LINK_CORE_BOTH_BUMPS="https://drive.google.com/drive/folders/YOUR_CORE_BOTH_BUMPS_LINK"
LINK_UPSELL_BUNDLE="https://drive.google.com/drive/folders/YOUR_UPSELL_BUNDLE_LINK"
