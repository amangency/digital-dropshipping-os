# LOGS & DIAGNOSTICS
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# RUNTIME DATA & CACHE
# ==============================================================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tmp
*.temp

# Large AI/ML models / binaries
*.traineddata
*.tar.gz
*.zip
*.7z
*.rar

